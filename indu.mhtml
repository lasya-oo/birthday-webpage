@charset "utf-8";

body { background: rgb(255, 244, 247); text-align: center; font-family: Ari=
al, sans-serif; padding: 30px; }

h1 { color: rgb(214, 51, 108); font-size: 42px; }

p { font-size: 20px; }

.special { color: rgb(255, 77, 109); font-weight: bold; }

img { width: 250px; height: 300px; object-fit: cover; margin: 15px; border-=
radius: 18px; box-shadow: rgba(0, 0, 0, 0.15) 0px 8px 20px; }

button { display: block; margin: 25px auto; padding: 14px 24px; font-size: =
18px; font-weight: bold; border-width: medium; border-style: none; border-c=
olor: currentcolor; border-image: none; border-radius: 25px; background: rg=
b(214, 51, 108); color: white; cursor: pointer; transition: 0.2s; }

#surprise { margin: 25px auto; padding: 25px; max-width: 500px; background:=
 white; border-radius: 20px; font-size: 24px; color: rgb(214, 51, 108); fon=
t-weight: bold; line-height: 1.8; }

h2 { margin-top: 40px; font-size: 30px; color: rgb(214, 51, 108); }

h2 + p { font-size: 22px; font-weight: bold; transform: rotate(-2deg); }

h1 { margin-bottom: 10px; }

p { margin: 12px; }

img { vertical-align: middle; }

#surprise { animation: 1s ease-in 0s 1 normal none running fadeIn; }

@keyframes fadeIn {=20
  0% { opacity: 0; transform: translateY(10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

button:hover { transform: rotate(-2deg) scale(1.05); }

#final { margin: 30px auto; padding: 25px; max-width: 500px; background: rg=
b(255, 214, 224); border-radius: 25px; font-size: 26px; font-weight: bold; =
color: rgb(214, 51, 108); animation: 0.7s ease-out 0s 1 normal none running=
 finalPop; }

#final small { font-size: 16px; display: block; margin-top: 12px; color: rg=
b(85, 85, 85); }

@keyframes finalPop {=20
  0% { transform: scale(0.5) rotate(-5deg); opacity: 0; }
  70% { transform: scale(1.1) rotate(2deg); }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}
